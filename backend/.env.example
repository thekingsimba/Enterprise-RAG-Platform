APP_NAME="Enterprise RAG Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"

API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rag_platform"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rag_platform"

REDIS_URL="redis://localhost:6379/0"

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="rag-platform-documents"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="rag-platform"

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="rag-platform"

CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

MLFLOW_TRACKING_URI="http://localhost:5000"
